# Cyber Sentinel — Environment Configuration
# Copy this file to .env and fill in your real values
# NEVER commit the .env file to version control

# ─── Database ───────────────────────────────────────────
# SQLite for MVP (default). Switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./cyber_sentinel.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cyber_sentinel_db

# ─── Telegram OSINT ────────────────────────────────────
# Get from: https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Comma-separated list of public channel usernames (no @ symbol)
TELEGRAM_CHANNELS=cybercrimealerts_india,taskscams,fraud_alerts_news

# ─── RSS Feeds ─────────────────────────────────────────
# Comma-separated list of RSS/Atom feed URLs
RSS_FEED_URLS=https://www.cert-in.org.in/rss.xml,https://www.cisa.gov/cybersecurity-advisories/all.xml,https://feeds.feedburner.com/TheHackersNews

# ─── Scheduler ─────────────────────────────────────────
# How often (in seconds) to run automated OSINT collection
OSINT_POLL_INTERVAL_SECONDS=300

# ─── AI Thresholds ─────────────────────────────────────
CAMPAIGN_SIMILARITY_THRESHOLD=0.85
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50

# ─── Security ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_256BIT_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Environment ───────────────────────────────────────
ENVIRONMENT=development

# ─── Optional: External API Enrichment ─────────────────
# VirusTotal: https://www.virustotal.com/gui/my-apikey (free tier: 4 req/min)
VIRUSTOTAL_API_KEY=

# URLScan.io: https://urlscan.io/user/profile/ (free tier: 60 req/min)
URLSCAN_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/account/api (free: 1000 req/day)
ABUSEIPDB_API_KEY=
